Toys = workspace.Toys
function CheckForDispenserAvailable()
    local TableToReturn = {}
    local PlayerData = GetPlayerData()
    for _, Name in pairs(DispensersToUse) do
        if not PlayerData.ToyTimes[Name] then
            ToyEvent:FireServer(Name)
            return
        end
        if Name == "Wealth Clock" and not _G.AutoWealthClock then
            continue
        end
        if Name == "Coconut Dispenser" then
            if not CrabTimer.Visible then
                continue
            end
        end
        if Name == "Gingerbread House" and not _G.AutoTreats_Gingerbread then
            continue
        end
        local Difference = os.time() - PlayerData.ToyTimes[Name]
        local Cooldown = Toys[Name]:FindFirstChild("Cooldown") or Toys[Name]:FindFirstChild("PlaytimeCooldown")
        if Name == "Gingerbread House" then
            Difference = Difference + Cooldown.Value
        end
        if Cooldown then
            if Difference >= Cooldown.Value then
                table.insert(TableToReturn, Name)
            end
        end
    end
    return TableToReturn
end

