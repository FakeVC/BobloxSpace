--// Collecting Blooms

local function IsBloomActive(Model, Petal)
    return Model.Parent and Petal.Parent and Petal.Transparency < 0.95
end

local BloomPriorityColors = {
    Red = Color3.fromRGB(249, 34, 34),
    Blue = Color3.fromRGB(33, 66, 249),
}

local BloomRayOriginOffset = Vector3.new(0, 5, 0)
local BloomRayDirection = Vector3.new(0, -200, 0)
local BloomRayWhitelist = {FieldZones}
local BloomTaskFieldKeys = {"Zone", "Field", "FieldName"}
local BloomPetalCache = setmetatable({}, {__mode = "k"})

local function MatchesBloomColor(Petal, ExpectedColor)
    local Color = Petal.Color
    return math.abs(Color.R - ExpectedColor.R) < 0.01
        and math.abs(Color.G - ExpectedColor.G) < 0.01
        and math.abs(Color.B - ExpectedColor.B) < 0.01
end

local function GetBloomTaskColor(TaskData)
    if typeof(TaskData) ~= "table" then
        return nil
    end

    local Color = TaskData.Color
    if typeof(Color) == "string" and BloomPriorityColors[Color] then
        return BloomPriorityColors[Color]
    end

    local Tags = TaskData.Tag
    if typeof(Tags) == "table" then
        for _, Value in ipairs(Tags) do
            if typeof(Value) == "string" and BloomPriorityColors[Value] then
                return BloomPriorityColors[Value]
            end
        end
    end

    return nil
end

local function GetBloomTaskField(TaskData)
    if typeof(TaskData) ~= "table" then
        return nil
    end

    for _, Key in ipairs(BloomTaskFieldKeys) do
        local Value = TaskData[Key]
        if typeof(Value) == "string" and FieldZones:FindFirstChild(Value) then
            return Value
        end
    end

    local Tags = TaskData.Tag
    if typeof(Tags) == "table" then
        for _, Value in ipairs(Tags) do
            if typeof(Value) == "string" and FieldZones:FindFirstChild(Value) then
                return Value
            end
        end
    end

    return nil
end

local function GetBloomPetal(Model)
    local Petal = BloomPetalCache[Model]
    if Petal and Petal:IsDescendantOf(Model) then
        return Petal
    end

    Petal = Model:FindFirstChild("Petal", true)
    if Petal and Petal:IsA("BasePart") then
        BloomPetalCache[Model] = Petal
        return Petal
    end
    return nil
end

local BloomModelFieldCache = setmetatable({}, {__mode = "k"})
local BloomPartFieldCache = setmetatable({}, {__mode = "k"})

local function GetCachedBloomField(Cache, CacheKey, Part)
    local FieldName = Cache[CacheKey]
    if FieldName == nil then
        local _Ray = Ray.new(Part.Position + BloomRayOriginOffset, BloomRayDirection)
        local Field = workspace:FindPartOnRayWithWhitelist(_Ray, BloomRayWhitelist)
        FieldName = Field and Field.Name or false
        Cache[CacheKey] = FieldName
    end

    if FieldName then
        return FieldZones[FieldName]
    end
    return nil
end

local function GetBloomModelField(Model, Petal)
    return GetCachedBloomField(BloomModelFieldCache, Model, Petal)
end

local function GetBloomPartField(PetalPart)
    return GetCachedBloomField(BloomPartFieldCache, PetalPart, PetalPart)
end

GetBloom = function(_, TaskData, IgnoredModels)
    local Happenings = workspace:FindFirstChild("Happenings")
    local PoppablePlants = Happenings and Happenings:FindFirstChild("PoppablePlants")
    if not PoppablePlants then
        return nil
    end

    local QuestField = GetBloomTaskField(TaskData)
    local PreferredColor = GetBloomTaskColor(TaskData)
    local NearestModel, NearestPetal, NearestDistance
    local PreferredModel, PreferredPetal, PreferredDistance

    for _, Model in ipairs(PoppablePlants:GetChildren()) do
        local Petal = GetBloomPetal(Model)
        if Petal
            and Petal:IsA("BasePart")
            and not (IgnoredModels and IgnoredModels[Model])
            and IsBloomActive(Model, Petal) then
            local Field = GetBloomModelField(Model, Petal)
            if Field and (not QuestField or Field.Name == QuestField) then
                local Distance = (Petal.Position - HumRoot.Position).Magnitude
                if not NearestDistance or Distance < NearestDistance then
                    NearestModel = Model
                    NearestPetal = Petal
                    NearestDistance = Distance
                end
                if PreferredColor and MatchesBloomColor(Petal, PreferredColor) then
                    if not PreferredDistance or Distance < PreferredDistance then
                        PreferredModel = Model
                        PreferredPetal = Petal
                        PreferredDistance = Distance
                    end
                end
            end
        end
    end

    return PreferredModel or NearestModel, PreferredPetal or NearestPetal
end

