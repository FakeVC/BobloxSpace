        print("❌ Улитка заблокирована гейтом (нужно 15 пчел).")
        return false
    end

    -- Летим к улитке и бьем
    local Primary = StumpSnail.PrimaryPart
    local SnailPlatform = Instance.new("Part", workspace)
    SnailPlatform.Name = "SnailPlatform"
    SnailPlatform.Anchored = true
    SnailPlatform.CanCollide = true
    SnailPlatform.Transparency = 1
    SnailPlatform.Size = Vector3.new(5, 2, 5)
    
    repeat
        task.wait()
        if not StumpSnail.Parent or not _G.AutoCompleteQuests then break end
        
        -- Телепортируемся над улиткой
        SnailPlatform.CFrame = CFrame.new(Primary.Position + Vector3.new(0, 20, 0))
        HumRoot.CFrame = SnailPlatform.CFrame * CFrame.new(0, SnailPlatform.Size.Y / 2 + 1, 0)
        
        -- Собираем токены Rage, если они появляются рядом
        for _, Token in pairs(Tokens:GetChildren()) do
            if Token:FindFirstChild("FrontDecal") and Token.FrontDecal.Texture == "rbxassetid://1442700745" then -- ID токена Rage
                if (Token.Position - Primary.Position).Magnitude <= 50 then
                    Tween:Create(HumRoot, TweenInfo.new(0.2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame = CFrame.new(Token.Position)}):Play()
                    task.wait(0.3)
                end
            end
        end
    until not StumpSnail.Parent or not _G.AutoCompleteQuests
    
    SnailPlatform:Destroy()
    return true
end

function FarmAutoQuestField(FieldName, Type, QuestData)
    local Field = FieldZones[FieldName]
    local Doing = true
    local Convert = false
    if Field then
        TweenTP(Field.Position + Vector3.new(0, 2, 0))
        wait(1)
        PlayerActivesCommand:FireServer({["Name"] = "Sprinkler Builder"})
        wait(0.5)
        if Type then
            coroutine.wrap(function()
                while Doing do task.wait(1)
                    if not Convert then
                        if Type == "Goo" then
                            PlayerActivesCommand:FireServer({Name = "Gumdrops"})
                        elseif Type == "MagicBeans" then
                            PlayerActivesCommand:FireServer({Name = "Magic Bean"})
                            task.wait(4)
                        end
                    end
                end
            end)()
        end
        repeat wait()
            if PollenBar.Size.X.Scale >= _G.ConvertBackpackAt then
                Convert = true
                TeleportToCFrame(SpawnCFrame.Value * CFrame.new(0, 2, 0))
                wait(0.5)
                Humanoid:MoveTo((SpawnCFrame.Value * CFrame.new(0, 2, 0)).Position)
                OnField = false
                wait(1)
                ConvertPollen("AutoQuests")
                task.wait(1)
                HumRoot.CFrame = CFrame.new(Field.Position + Vector3.new(0, 2, 0))
                Convert = false
            end
            EquipMask(_G.MaskForFarm)
            CollectTokensForAutoQuests(75, Field, QuestData.TaskData)
            if (HumRoot.Position - Field.Position).Magnitude >= 10 then
                repeat wait()
                    Humanoid:MoveTo(Field.Position)
                    if (HumRoot.Position.Y - Field.Position.Y) >= 5 or (Field.Position.Y - HumRoot.Position.Y) >= 5 or (HumRoot.Position - Field.Position).Magnitude >= 90 then
                        HumRoot.CFrame = CFrame.new(Field.Position + Vector3.new(0, 2, 0))
                    end
                until (HumRoot.Position - Field.Position).Magnitude <= 7 or not _G.AutoCompleteQuests or GetNextTask(QuestData.NPC) ~= QuestData.Task
            end
        until not _G.AutoCompleteQuests or GetNextTask(QuestData.NPC) ~= QuestData.Task or _G.AutoCompleteQuestsNPC ~= QuestData.NPC
        Doing = false
        if _G.AutoCompleteQuestsNPC == QuestData.NPC then
            if GetNextTask(QuestData.NPC) ~= QuestData.Task then
                print("Task "..QuestData.Task..": Completed!\nGoing to do next Task!")
            end
        end
    end
end

local function GetFieldForTokensFarm(Tag)
    local FieldToReturn
    local Fields
    if string.find(Tag, "Blue") then
        Fields = {"Pine Tree Forest", "Stump Field", "Bamboo Field", "Blue Flower Field"}
    elseif string.find(Tag, "Red") or string.find(Tag, "Strawberry") then
        Fields = {"Pepper Patch", "Rose Field", "Strawberry Field", "Mushroom Field"}
    elseif string.find(Tag, "White") then
        Fields = {"Coconut Field", "Pumpkin Patch", "Pineapple Patch", "Spider Field", "Dandelion Field"}
    end
    if Fields then
        for _, Field in pairs(Fields) do
            local Gate = FieldsGates[Field]
            if Gate and Gate ~= "0 Bees" then
                if Gates[Gate].CanCollide then
                    continue
                else
                    FieldToReturn = Field
                    break
                end
            end
        end
    else
        FieldToReturn = _G.FarmingField
    end
    return FieldToReturn
end

local function CheckMonstersForQuest(MonsterName)
    local MonstersAvailable = false
    for _, MonsterZone in pairs(MonstersTable) do
        if MonsterZone.MonsterType.Value == MonsterName and not BlockedMonsters[MonsterZone.MonsterType.Value] then
            local Timer = FindTimerLabel(MonsterZone)
            if Timer and not Timer.Visible then
                MonstersAvailable = true
                break
            end
        end
    end
    return MonstersAvailable
end

