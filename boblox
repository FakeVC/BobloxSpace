-- Global Config

GlobalConfigName = "CONFIG"

local function CheckForValidConfig(Key)
    if UIToggles[Key] or UISliders[Key] or UIDropdowns[Key] or UITextBoxes[Key] then
        return true
    end
    return false
end

local function ChangeElementForConfig(Key, Value)
    if UIToggles[Key] then
        coroutine.wrap(function()
            UIToggles[Key]:Change()
        end)()
        return
    end
    if UISliders[Key] then
        coroutine.wrap(function()
            UISliders[Key]:SetValue(Value)
        end)()
        return
    end
    if UIDropdowns[Key] then
        coroutine.wrap(function()
            if Key == "FarmingMode" and Value == "Tween" then
                UIDropdowns[Key]:SetValue("Smooth", true)
            else
                UIDropdowns[Key]:SetValue(Value)
            end
        end)()
        return
    end
    if UITextBoxes[Key] then
        coroutine.wrap(function()
            UITextBoxes[Key]:SetValue(Value)
        end)()
        return
    end
end

