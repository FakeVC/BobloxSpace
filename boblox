                if string.find(Object.Name, "Epic") then Rarity = "Epic" end
                if string.find(Object.Name, "Legendary") then Rarity = "Legendary" end
                if string.find(Object.Name, "Mythic") then Rarity = "Mythic" end

                if not PuffshroomToReturn.Rarity then
                    PuffshroomToReturn.Rarity = PuffshroomRarity[Rarity]
                    PuffshroomToReturn.Model = Object
                    PuffshroomToReturn.Stem = Stem
