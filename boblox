    until PollenBar.Size.X.Scale <= 0 or (not _G.ConvertingPollen and not AutoQuests) or (AutoQuests and not _G.AutoCompleteQuests)
    if _G.ConvertingPollen or (AutoQuest and _G.AutoCompleteQuests) then
