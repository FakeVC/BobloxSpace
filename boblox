        return false
    end
    Seen[TaskData] = true

    for _, Value in pairs(TaskData) do
        if typeof(Value) == "string" then
            local Normalized = string.lower(Value)
            if string.find(Normalized, "bloom", 1, true) or string.find(Normalized, "petal", 1, true) then
