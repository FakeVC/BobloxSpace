CollectBloomPetalParts = function(BloomPosition, BloomField)
    local Particles = workspace:FindFirstChild("Particles")
    if not Particles then
        return false
    end

    local PetalParts = {}
    for _, Object in ipairs(Particles:GetChildren()) do
        if Object.Name == "PetalPart"
            and Object:IsA("BasePart")
            and Object.Transparency < 0.95
            and (Object.Position - BloomPosition).Magnitude <= 125
            and (not BloomField or GetBloomPartField(Object) == BloomField) then
            table.insert(PetalParts, Object)
        end
    end

    table.sort(PetalParts, function(First, Second)
        return (First.Position - HumRoot.Position).Magnitude < (Second.Position - HumRoot.Position).Magnitude
    end)

    for _, PetalPart in ipairs(PetalParts) do
        if PetalPart.Parent and PetalPart.Transparency < 0.95 then
            TweenToQuestPetal(PetalPart)
        end
    end

    return #PetalParts > 0
end

local function CollectBloomPetalsForQuest(QuestData)
    local IgnoredModels = GetBloomQuestHistory(QuestData)
    local Model, Petal = GetBloom(QuestData.NPC, QuestData.TaskData, IgnoredModels)
    if not Model or not Petal then
        return false
    end

    local Field = GetBloomModelField(Model, Petal)
    if not Field then
        IgnoredModels[Model] = true
        return false
    end

    local BloomPosition = Petal.Position
    StartBloomAt(BloomPosition, 0.2)

    local Deadline = os.clock() + 15
    repeat
        local HasPetalParts = CollectBloomPetalParts(BloomPosition, Field)
        if not HasPetalParts then
            if not _G.AutoDiging then
                FireCharacterClickEvents()
            end
            CollectTokensForAutoQuests(125, Field, QuestData.TaskData)
        end
        task.wait(0.03)
    until not IsBloomActive(Model, Petal)
        or not _G.AutoCompleteQuests
        or GetNextTask(QuestData.NPC) ~= QuestData.Task
        or os.clock() >= Deadline

    if _G.AutoCompleteQuests and GetNextTask(QuestData.NPC) == QuestData.Task then
        IgnoredModels[Model] = true
    end

    return true
end

