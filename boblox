    EquipMask("Honey Mask")
    repeat wait()
        if Humanoid.Health <= 0 then
            repeat wait() until Humanoid.Health > 0 or (not _G.ConvertingPollen and not AutoQuests) or (AutoQuests and not _G.AutoCompleteQuests)
        end
        if (HumRoot.Position - SpawnCFrame.Value.Position).Magnitude >= 7 or (HumRoot.Position.Y - SpawnCFrame.Value.Position.Y) >= 5 then
