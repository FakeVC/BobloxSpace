local function TweenTP(NeedCFrame)
    if typeof(NeedCFrame) == "Vector3" then
        NeedCFrame = CFrame.new(NeedCFrame)
    end
    local Time = (HumRoot.Position - NeedCFrame.Position).Magnitude / _G.TweenSpeed

    if not NoclipConnection then
        Noclip()
    end

    TeleportPart.CFrame = CFrame.new(HumRoot.Position + Vector3.new(0, -2, 0))
    Tween:Create(HumRoot, TweenInfo.new(Time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
        CFrame = NeedCFrame
    }):Play()
    Tween:Create(TeleportPart, TweenInfo.new(Time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
        CFrame = NeedCFrame * CFrame.new(0, -2, 0)
    }):Play()
    task.wait(Time + 0.1)
    TeleportPart.CFrame = CFrame.new(0, -500, 0)
    if NoclipConnection then
        Noclip()
    end
end

local function FixTime(Time)
    if string.len(tostring(Time)) == 1 then
        Time = "0"..math.floor(Time)
    else
        Time = math.floor(Time)
    end
    return Time
end

