local function GetTokensForFarm(Distance, AllowedTokens)
    local RootPosition = HumRoot.Position
    local MaxDistanceSquared = Distance * Distance
    local PriorityLookup = {}
    local PriorityToken
    local PriorityDistanceSquared
    local CommonToken
    local CommonDistanceSquared

    for _, Texture in ipairs(_G.Tokens.Priority) do
        PriorityLookup[Texture] = true
    end

    for Token in pairs(ActiveTokens) do
        if Token:IsA("BasePart")
            and Token.Parent == Tokens
            and not CollectedTokens[Token]
            and Token.Transparency < 0.85 then
            local Decal = Token:FindFirstChild("FrontDecal")
            if Decal and (not AllowedTokens or AllowedTokens[Decal.Texture]) then
                local Offset = Token.Position - RootPosition
                local DistanceSquared = Offset:Dot(Offset)

                if DistanceSquared <= MaxDistanceSquared then
                    if PriorityLookup[Decal.Texture] then
                        if not PriorityDistanceSquared or DistanceSquared < PriorityDistanceSquared then
                            PriorityToken = Token
                            PriorityDistanceSquared = DistanceSquared
                        end
                    elseif not CommonDistanceSquared or DistanceSquared < CommonDistanceSquared then
                        CommonToken = Token
                        CommonDistanceSquared = DistanceSquared
                    end
                end
            end
        end
    end

    return PriorityToken or CommonToken
end

function CollectTokens(Action, Distance, WithoutFarm, Icons, SavedField)
    --for _ = 1, 25 do
        local Token = GetTokensForFarm(Distance or 50, Icons)
        if not Token then
            return
        end
        if Token.Parent == Tokens
            and Token:IsA("BasePart")
            and Token.Transparency < 0.85
            and not CollectedTokens[Token]
            and Token:FindFirstChild("FrontDecal") then
            SavedField = SavedField or _G.FarmingField
            local FieldPos = FieldZones[SavedField].CFrame.Position
            local Position = Token.Position
            if _G.FarmingMode == "Walk" then
                repeat task.wait(0.1)
                    Humanoid:MoveTo(Position)
                    if not CheckForCollectTokens(Action) then
                        return
                    end
                    if SavedField ~= _G.FarmingField then
                        Humanoid:MoveTo(HumRoot.Position)
                        break
                    end
                    if (_G.Farming or WithoutFarm) and not KillingStickBug and not CollectingMeteor and not CollectingPuffshrooms and not CollectingBloom and not CollectingPlanter and not KillingCrab and not KillingWindy and not CollectingSparkles and not CollectingFireflys and not KillingCommando and not KillingMondo and not KillingMobs and not KillingVicious and ((HumRoot.Position.Y - FieldPos.Y) >= 5 or (FieldPos.Y - HumRoot.Position.Y) >= 5 or (HumRoot.Position - FieldPos).Magnitude >= 90) then
                        HumRoot.CFrame = CFrame.new(FieldZones[SavedField].CFrame.Position + Vector3.new(0, 2, 0))
                    end
                until ((HumRoot.Position - Position).Magnitude <= 6) or (_G.SavedFarmingField ~= SavedField and (not SproutNow or not _G.FarmingSprouts)) or not Token.Parent or Humanoid.Health <= 0 or (PollenBar.Size.X.Scale >= _G.ConvertBackpackAt and (_G.Farming or WithoutFarm))
            elseif _G.FarmingMode == "Tween" then
                TeleportToCFrame(CFrame.new(Position.X, HumRoot.Position.Y, Position.Z))
                --task.wait(0.15)
            elseif _G.FarmingMode == "Teleport" then
                HumRoot.CFrame = CFrame.new(Position)
                wait(0.15)
            end
            if SavedField ~= _G.FarmingField then
                return false
            end
            CollectedTokens[Token] = true
            if not CheckForCollectTokens(Action) then
                return
            end
            if DoingQuestsNow then
                _G.Farming = false
                _G.ConvertingPollen = false
                return
            end

            if _G.CollectTickets and NeedToCollectTickets then
                for _ = 1, 15 do
                    CollectTickets()
                end
                NeedToCollectTickets = false
            end
            --[[if (_G.Farming or WithoutFarm) and not KillingStickBug and not CollectingMeteor and not CollectingPuffshrooms and not CollectingBloom and not CollectingPlanter and not KillingCrab and not KillingWindy and not CollectingSparkles and not CollectingFireflys and not KillingCommando and not KillingMondo and not KillingMobs and not KillingVicious and ((HumRoot.Position.Y - FieldZones[_G.FarmingField].CFrame.Position.Y) >= 5 or (FieldZones[_G.FarmingField].CFrame.Position.Y - HumRoot.Position.Y) >= 5 or (HumRoot.Position - FieldZones[_G.FarmingField].CFrame.Position).Magnitude >= 120) then
                HumRoot.CFrame = CFrame.new(FieldZones[_G.FarmingField].CFrame.Position + Vector3.new(0, 2, 0))
            end--]]
            if _G.CollectMeteor and #MeteorsTable >= 1 then
                CollectMeteor()
            end
            if _G.Farming and (not KillingMobs and not KillingWindy and not KillingMondo and not KillingVicious) then
                if _G.CollectCoconuts then
                    CollectCoconuts()
                end
                if _G.AutoCollectBubbles then
                    CollectBubbles()
                end
                if _G.AutoCollectFuzzyBombs then
                    CollectFuzzyBombs()
                end
                if _G.CollectCrosshairs then
                    CollectCrosshairs()
                end
                if _G.CollectFlames then
                    CollectFlames()
                end
                if _G.CollectDupedTokens then
                    CollectDupedTokens()
                end
                if _G.FarmTennisBall then
                    FarmTennisBall()
                end
            end

            local SavedPosition = HumRoot.CFrame.Position
            if ViciousNow and _G.AutoKillVicious and not KillingWindy then
                KillVicious()
                TeleportToCFrame(CFrame.new(SavedPosition))
            end
            if WindyNow and _G.HuntWindy and not KillingWindy and not KillingVicious then
                KillWindy()
                TeleportToCFrame(CFrame.new(SavedPosition))
            end

            --[[if not KillingMobs and not KillingWindy and not KillingVicious and not KillingMondo and not KillingCommando then
                EquipMask(_G.MaskForFarm)
            end--]]

            if PollenBar.Size.X.Scale >= _G.ConvertBackpackAt then
                return
            end

            if Humanoid.Health <= 0 then
                if (_G.Farming or WithoutFarm) then
                    repeat wait() until Humanoid.Health > 0 or (not _G.Farming or _G[Action])
                    if (_G.Farming or WithoutFarm) then
                        TeleportToField()
                        wait(0.3)
                        SetSprinkler()
                    end
                    return
                else
                    return
                end
            end

            return true
