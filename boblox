local function GetQuestTaskData(Quest, Id) -- TaskId
    local QuestData = Quests:Progress(Quest, ClientStatCache:Get())
    return {Collected = QuestData[Id][2], Require = QuestData[Id][3]}
end
 
local function CheckTaskForComplete(Quest, Id) -- TaskId
    local TaskData = GetQuestTaskData(Quest, Id)
    if TaskData.Collected >= TaskData.Require then
        return true
    end
    return false
end

local function GetRepeatQuest(Stats, Quest)
    for Id, Data in pairs(Stats) do
        if Data.Name == Quest then
            return Data
        end
    end
    return nil
end

local function GetTaskType(NPC, Quest, TaskId)
    local NPCStats = RepeatQuests[NPC]
    if NPCStats then
        local QuestData = GetRepeatQuest(NPCStats.Quests, Quest)
        return QuestData.Tasks[TaskId].Type
    end
    return false
end

local function WaitForQuestTaskRefresh(QuestName, TaskId, PreviousCollected)
    local Deadline = os.clock() + 5

    repeat
        task.wait(0.1)
        local Progress = Quests:Progress(QuestName, ClientStatCache:Get())
        local TaskProgress = Progress and Progress[TaskId]

        if not TaskProgress
            or TaskProgress[2] ~= PreviousCollected
            or TaskProgress[2] >= TaskProgress[3] then
            return true
        end
    until os.clock() >= Deadline or not _G.AutoCompleteQuests

    return false
end

function GetNextTask(NPCName)
    local QuestName = FindQuestByNPC(NPCName)
    local QuestData = Quests:Progress(QuestName, ClientStatCache:Get())
    local Task
    for TaskId, _ in pairs(QuestData) do
        if not CheckTaskForComplete(QuestName, TaskId) then
            Task = TaskId
            break
        end
    end
    if not Task then
        return "Quest Completed!"
    end
    return Task, GetTaskType(NPCName, QuestName, Task)
end

local function CheckQuestForComplete(NPCName)
    local QuestName = FindQuestByNPC(NPCName)
    if QuestName then
        local QuestData = Quests:Progress(QuestName, ClientStatCache:Get())
        local MaxTasks = #QuestData
        local CompletedTasks = 0
        for Id, _ in pairs(QuestData) do
            if CheckTaskForComplete(QuestName, Id) then
                CompletedTasks = CompletedTasks + 1
            end
        end
        if CompletedTasks >= MaxTasks then
            return true
        end
        return false
    end
    return "Quest don't found"
end

