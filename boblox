local WaitingForSproutCollected = false
local DiedFarmConnection
function Farm(Data)
    if DiedFarmConnection then
        DiedFarmConnection:Disconnect()
    end
    if not Data.AutoCompleteQuests then
        if CollectingSproutWithoutFarm then
            if Data.Action == "Stop Farm" then
                WaitingForSproutCollected = false
                return false
            end
            if Data.Action == "Start Farm" then
                WaitingForSproutCollected = true
                repeat wait() until not CollectingSproutWithoutFarm or not WaitingForSproutCollected
                if not WaitingForSproutCollected then
                    return false
                end
            end
        end
    end
    if Data.Action == "Start Farm" then
        _G.Farming = true

        do -- Check for Other Functions Work Right Now
            if KillingMobs then repeat wait() until not KillingMobs or not _G.Farming end
            if KillingVicious then repeat wait() until not KillingVicious or not _G.Farming end
            if KillingWindy then repeat wait() until not KillingWindy or not _G.Farming end
            if KillingCommando then repeat wait() until not KillingCommando or not _G.Farming end
            if KillingMondo then repeat wait() until not KillingMondo or not _G.Farming end
            if KillingCrab then repeat wait() until not KillingCrab or not _G.Farming end
            if KillingStickBug then repeat wait() until not KillingStickBug or not _G.Farming end
            if CollectingPuffshrooms then repeat wait() until not CollectingPuffshrooms or not _G.Farming end
            if CollectingBloom then repeat wait() until not CollectingBloom or not _G.Farming end
            if CollectingMeteor then repeat wait() until not CollectingMeteor or not _G.Farming end
            if CollectingFireflys then repeat wait() until not CollectingFireflys or not _G.Farming end
            if CollectingSprout then repeat wait() until not CollectingSprout or not _G.Farming end
            if CollectingTickets then repeat wait() until not CollectingTickets or not _G.Farming end
            if FarmingGuidingStar then repeat wait() until not FarmingGuidingStar or not _G.Farming end
            if FarmingAnts then repeat wait() until not FarmingAnts or not _G.Farming end
            if DoingQuestsNow then repeat wait() until not DoingQuestsNow or not _G.Farming end
            if _G.CollectSnowflakes then repeat wait() until not _G.CollectSnowflakes or not _G.Farming end
            if not _G.Farming then
                return
            end
        end

        if Data.CollectSprout then
            CollectingSproutWithoutFarm = true
        end
        if Data.FarmGuiding then
            FarmingGuidingStar = true
        end

        local CharacterDead = false
        DiedFarmConnection = Humanoid.Died:Connect(function()
            CharacterDead = true
        end)
        local SavedField = _G.FarmingField
        local OnField = false

        EquipMask(_G.MaskForFarm)
        while _G.Farming do
            if not Data.AutoCompleteQuests then
                if SproutNow then
                    if not SproutNow.Parent then
                        SproutNow = nil
                        SproutField = nil
                        _G.FarmingField = _G.SavedField
                    end
                else
                    if SavedField ~= _G.FarmingField then
                        OnField = false
                        SavedField = _G.FarmingField
                    end
                end
            end
            if PollenBar.Size.X.Scale < _G.ConvertBackpackAt and not OnField then
                TeleportToField()
                OnField = true
                wait(0.3)
                SetSprinkler()
            end
            if PollenBar.Size.X.Scale >= _G.ConvertBackpackAt then
                --print(PollenBar.Size.X.Scale, _G.ConvertBackpackAt)
                if _G.AutoUseInstantConventer then
                    UseInstantConventer(_G.ConvertBackpackAt)
                end
                if PollenBar.Size.X.Scale >= _G.ConvertBackpackAt then
                    if _G.AutoUseMicroConventer then
                        UseMicroConventer(_G.ConvertBackpackAt)
                    end
                end
                if PollenBar.Size.X.Scale >= _G.ConvertBackpackAt then
                    TeleportToCFrame(SpawnCFrame.Value * CFrame.new(0, 2, 0))
                    wait(0.5)
                    Humanoid:MoveTo((SpawnCFrame.Value * CFrame.new(0, 2, 0)).Position)
                    OnField = false
                    wait(1)
                    ConvertPollen()
                end
            end
            if OnField then
                if not Data.AutoCompleteQuests then -- Main Collect Tokens
                    if not Data.WithoutFarm then
                        for _ = 1, 15 do
                            local Collected
                            if SproutNow and _G.FarmingSprouts then
                                Collected = CollectTokens("Farming", nil, nil, nil, _G.FarmingField)
                            else
                                Collected = CollectTokens("Farming", nil, nil, nil, SavedField)
                            end

                            if not Collected then
                                break
                            end
                        end
                    else
                        if Data.CollectSprout then
                            CollectTokens("FarmingSprouts", 35, true)
                        end
                        if Data.FarmGuiding then
                            CollectTokens("HuntGuidingStar", 35, true)
                        end
                    end
                end
                if (_G.Farming or _G.WithoutFarm or Data.AutoCompleteQuests) then
                    if not SproutNow and not GuidingStarNow then -- Checking for not Right Field
                        if SavedField ~= _G.FarmingField then
                            OnField = false
                            SavedField = _G.FarmingField
                            TeleportToField()
                            OnField = true
                            wait(0.3)
                            SetSprinkler()
                        end
                    end

                    local FieldCFrame = FieldZones[_G.FarmingField].CFrame * CFrame.new(0, 1.5, 0)
                    if (HumRoot.Position - FieldCFrame.Position).Magnitude >= 10 then -- Going to Center of Field
                        if _G.FarmingMode == "Walk" then
                            local FieldPosition = FieldZones[_G.FarmingField].CFrame.Position
                            repeat task.wait(0.1)
                                FieldPosition = FieldZones[_G.FarmingField].CFrame.Position
                                Humanoid:MoveTo(FieldPosition)
                                if SavedField ~= _G.FarmingField then
                                    Humanoid:MoveTo(HumRoot.Position)
                                    break
                                end
                                if (_G.Farming or _G.WithoutFarm or Data.AutoCompleteQuests) and not KillingStickBug and not CollectingMeteor and not CollectingPuffshrooms and not CollectingBloom and not CollectingPlanter and not KillingCrab and not KillingWindy and not CollectingSparkles and not CollectingFireflys and not KillingCommando and not KillingMondo and not KillingMobs and not KillingVicious and ((HumRoot.Position.Y - FieldPosition.Y) >= 5 or (FieldPosition.Y - HumRoot.Position.Y) >= 5 or (HumRoot.Position - FieldPosition).Magnitude >= 90) then
                                    HumRoot.CFrame = CFrame.new(FieldZones[_G.FarmingField].CFrame.Position + Vector3.new(0, 2, 0))
                                end
                                if CharacterDead then
                                    CharacterDead = false
                                    repeat wait() until Humanoid.Health > 0 or (not _G.Farming and not _G.WithoutFarm and not _G.AutoCompleteQuests)
                                    DiedFarmConnection = Humanoid.Died:Connect(function()
                                        CharacterDead = true
                                    end)
                                    if (_G.Farming or _G.WithoutFarm or Data.AutoCompleteQuests) then
                                        TeleportToField()
                                        OnField = true
                                        wait(0.3)
                                        SetSprinkler()  
                                    end
                                    break
                                end
                                if not Data.AutoCompleteQuests then
                                    if SproutNow and SproutField then
                                        if not _G.FarmingSprouts then
                                            break
                                        end
                                    end
                                end
                            until (HumRoot.Position - FieldPosition).Magnitude <= 6 or Humanoid.Health <= 0 or not _G.Farming or PollenBar.Size.X.Scale >= _G.ConvertBackpackAt
                        elseif _G.FarmingMode == "Tween" then
                            TeleportToCFrame(FieldCFrame)
                        elseif _G.FarmingMode == "Teleport" then
                            HumRoot.CFrame = FieldCFrame
                        end
                    end

                    if DoingQuestsNow then -- if player enable "Auto Complete Quests"
                        _G.WaitingForFarming = true
                        _G.Farming = false
                        _G.ConvertingPollen = false
                        break
                    end

                    if not Data.AutoCompleteQuests then -- Checking for Guiding or Sprout or Planter(s) and Collect they
                        if not SproutNow and not Data.AutoCompleteQuests then
                            if not GuidingStarNow and _G.HuntGuidingStar then
                                local GuidingStarNow, GSField = CheckForGuidingStar()
                                if GuidingStarNow and GSField then
                                    _G.FarmingField = GSField.Name
                                    TeleportToField()
                                    wait(0.3)
                                    SetSprinkler()
                                end
                            else
                                if GuidingStarNow and not GuidingStarNow.Parent and _G.HuntGuidingStar then
                                    GuidingStarNow = nil
                                    GuidingStarField = nil
                                    if _G.Farming then
                                        _G.FarmingField = _G.SavedFarmingField
                                        if Data.FarmGuiding then
                                            FarmingGuidingStar = false
                                            return
                                        end
                                        if not SproutNow then
                                            _G.Farming = false
                                            _G.ConvertingPollen = false
                                            return
                                        end
                                        TeleportToField()
                                        wait(0.3)
                                        SetSprinkler()
                                    end
                                end
                            end
                        end

                        if not SproutNow and _G.FarmingSprouts then
                            local Sprout, SPField = CheckForSprout()
                            if Sprout and SPField then
                                _G.SavedField = _G.FarmingField
                                _G.FarmingField = SPField.Name
                                InstantConvertBag()
                                TeleportToField()
                                wait(0.3)
                                SetSprinkler()
                            end
                        else
                            if SproutNow and not SproutNow.Parent and _G.FarmingSprouts then
                                for _ = 1, 20 do
                                    CollectTokens("FarmingSprouts", 95, true, SproutDrops)
                                end
                                SproutNow = nil
                                SproutField = nil
                                SproutsCollected = SproutsCollected + 1
                                if _G.Farming then
                                    if _G.HuntGuidingStar and GuidingStarNow then
                                        _G.FarmingField = GuidingStarField.Name
                                        if Data.CollectSprout or Data.FarmingGuiding then
                                            FarmingGuidingStar = true
                                        end
                                    else
                                        _G.FarmingField = _G.SavedFarmingField
                                        if Data.CollectSprout or Data.FarmingGuiding then
                                            FarmingGuidingStar = false
                                        end
                                        if Data.CollectSprout then
                                            CollectingSproutWithoutFarm = false
                                            _G.Farming = false
                                            _G.ConvertingPollen = false
                                            return
                                        end
                                    end
                                    TeleportToField()
                                    wait(0.3)
                                    SetSprinkler()
                                end
                            end
                        end

                        if not _G.FarmingSprouts and SproutNow then
                            SproutNow = nil
                            SproutField = nil
                            if _G.Farming then
                                if _G.HuntGuidingStar and GuidingStarNow then
                                    _G.FarmingField = GuidingStarField.Name
                                    if Data.CollectSprout or Data.FarmingGuiding then
                                        FarmingGuidingStar = true
                                    end
                                else
                                    _G.FarmingField = _G.SavedFarmingField
                                    FarmingGuidingStar = false
                                    if Data.CollectSprout then
                                        CollectingSproutWithoutFarm = false
                                        _G.Farming = false
                                        _G.ConvertingPollen = false
                                        return
                                    end
                                end
                                TeleportToField()
                                wait(0.3)
                                SetSprinkler()
                            end
                        end
                        if not _G.HuntGuidingStar and GuidingStarNow then
                            GuidingStarNow = nil
                            GuidingStarField = nil
                            if _G.Farming then
                                _G.FarmingField = _G.SavedFarmingField
                                TeleportToField()
                                wait(0.3)
                                SetSprinkler()
                            end
                        end
                    
                        if ((not SproutNow and not GuidingStarNow) or (not _G.FarmingSprouts and not _G.HuntGuidingStar)) then -- Planters
                            for PlanterDataId, PlanterData in next, _G.Planter do
                                if PlanterData.Enabled then
                                    local Data = CheckForPlanter(PlanterDataId)
                                    if Data.PlantersSetted and Data.PlantersSetted >= 3 then -- If player already have 3 setted planters
                                        continue
                                    end
                                    if Data.Found and Data.NeedToCollect then -- Collecting Planter
                                        CollectPlanter(Data.CFrame, Data.Id)
                                        task.wait(0.5)
                                        TweenTP(FieldZones[_G.FarmingField].Position + Vector3.new(0, 2, 0))
                                    elseif not Data.Found then -- Setting Planter
                                        TweenTP(FieldZones[PlanterData.Field].Position)
                                        task.wait(0.5)
                                        PlayerActivesCommand:FireServer({Name = PlanterData.Type})
                                        task.wait(0.5)
                                        TweenTP(FieldZones[_G.FarmingField].Position + Vector3.new(0, 2, 0))
                                    end
                                end
                            end
                            for _, Planter in pairs(debug.getupvalues(require(game:GetService("ReplicatedStorage").LocalPlanters).LoadPlanter)[4]) do -- Check For Planters
                                if Planter.GrowthPercent == 1 and Planter.IsMine then
                                    CollectPlanter(Planter.BulbPart.CFrame, Planter.ActorID)
                                end
                            end
                        end

                        --[[if _G.AutoPlanter and ((not SproutNow and not GuidingStarNow) or (not _G.FarmingSprouts and not _G.HuntGuidingStar)) then
                            local CheckForPlanter = CheckForPlanters()
                            if CheckForPlanter == true then
                                CollectingPlanter = true
                                for Id, Planter in pairs(Planters) do
                                    HumRoot.CFrame = CFrame.new(Planter.CFrame.Position)
                                    Humanoid:MoveTo(Planter.CFrame.Position)
                                    wait(2.5)
                                    game:GetService("ReplicatedStorage").Events.PlanterModelCollect:FireServer(Planter.Id)
                                    wait(2)
                                    for _ = 1, 5 do
                                        CollectTokens("AutoPlanter", 35, true)
                                    end
                                    Planters[Id] = nil
                                end
                                CollectingPlanter = false
                            elseif CheckForPlanter == false then
                                PlayerActivesCommand:FireServer({Name = _G.PlanterSelected})
                            end
                        end--]]
                    end

                    do -- Another Functions
                        if _G.AutoStickBug and StickBugUI.Position.X.Scale == 0 then
                            KillStickBug()
                        end
                        if _G.AutoPuffshrooms and #workspace.Happenings.Puffshrooms:GetChildren() >= 1 then
                            CollectPuffshrooms()
                            task.wait(1)
                            TeleportToField()
                            task.wait(0.3)
                            SetSprinkler()
                        end
                        if _G.AutoBloom and GetBloom() then
                            CollectBlooms()
                            task.wait(1)
                            TeleportToField()
                            task.wait(0.3)
                            SetSprinkler()
                        end
                        if _G.CollectFireflys and workspace.NPCBees:FindFirstChild("Firefly") then
                            CollectFireflys()
                        end
                        if _G.HuntMondo and MondoReady then
                            KillMondo()
                        end
                        if _G.HuntCommando and CommandoReady then
                            KillCommando()
                        end
                        if _G.TrainCrab and CrabReady then
                            KillCrab()
                        end
                        if _G.CollectSparkles and NeedToCollectSparkles then
                            CollectSparkles()
                        end
                        if _G.AutoAnt then
                            FarmAnts()
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    elseif Data.Action == "Stop Farm" then
         _G.Farming = false
         _G.ConvertingPollen = false
    end
end

local Ballons = workspace.Balloons
local function FindHiveBallon()
    local Ballon
    for _, Object in pairs(Ballons.HiveBalloons:GetChildren()) do
        if Object:FindFirstChild("BalloonRoot") then
            if (Object.BalloonRoot.Position - SpawnCFrame.Value.Position).Magnitude <= 15 then
                print("Balloon Finded")
                Ballon = Object
                break
            end
        end
    end
    if Ballon then
        return Ballon, Ballon.BalloonBody.GuiAttach.Gui.BlessingBar.TextLabel
    end
end

local ActionButton = Player.PlayerGui.ScreenGui.ActivateButton
function ConvertHiveBallon()
    local Ballon, TextLabel = FindHiveBallon()
    if Ballon and _G.AutoConvertHiveBallon and tonumber(string.sub(TextLabel.Text, 16, 100)) >= _G.ConvertHiveBallonAfter then
        TeleportToCFrame(SpawnCFrame.Value * CFrame.new(0, 2, 0))
        wait(1)
        if ActionButton.BackgroundColor3 ~= Color3.fromRGB(201, 39, 28) then
            PlayerHiveCommand:FireServer("ToggleHoneyMaking")
        end
        repeat wait()
            if ViciousNow and _G.AutoKillVicious and not KillingStickBug then
                KillVicious()
                TeleportToCFrame(SpawnCFrame.Value * CFrame.new(0, 2, 0))
                wait(1)
                PlayerHiveCommand:FireServer("ToggleHoneyMaking")
            end
            if WindyNow and _G.HuntWindy and not KillingStickBug then
                KillWindy()
                TeleportToCFrame(SpawnCFrame.Value * CFrame.new(0, 2, 0))
                wait(1)
                PlayerHiveCommand:FireServer("ToggleHoneyMaking")
            end
        until not Ballon.Parent or not _G.AutoConvertHiveBallon
        if _G.AutoConvertHiveBallon then
            task.wait(9)
        end
        task.wait(0.5)
    end
