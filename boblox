    local ConfigFile = readfile("BOBLOX_SWARM_BSS_"..GlobalConfigName..".json")
    if not ConfigFile then
        return false
    end
    for Key, Value in pairs(HttpService:JSONDecode(ConfigFile)) do
        if Key == "Planter" then
            for Id, Data in next, _G.Planter do
                PlantersToggles[Id]:Change()
                PlantersFields[Id]:SetValue(Value[Id].Field, true)
                PlantersType[Id]:SetValue(Value[Id].Type, true)
                PlantersSliders[Id]:SetValue(Value[Id].Percent * 100, true)

                Data.Enabled = Value[Id].Enabled
                Data.Percent = Value[Id].Percent
                Data.Type = Value[Id].Type
                Data.Field = Value[Id].Field
            end
            continue
        end
        if CheckForValidConfig(Key) and _G[Key] ~= Value then
            if Value ~= false and Value ~= nil then
                ChangeElementForConfig(Key, Value)
            end
            if _G[Key] ~= Value then
                _G[Key] = Value
            end
        end
    end
end, {text = "Load"})

