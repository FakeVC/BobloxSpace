local function CheckForPlanter(Id)
    local ReturnData = {PlantersSetted = 0}
    for _, Planter in pairs(debug.getupvalues(require(game:GetService("ReplicatedStorage").LocalPlanters).LoadPlanter)[4]) do -- Check For Planters
        if Planter.IsMine then
            if ReturnData.PlantersSetted then
                ReturnData.PlantersSetted += 1
            end
            if Planter.PotModel.Name == _G.Planter[Id].Type then -- Planter in Data
                ReturnData.Found = true
                ReturnData.PlantersSetted = nil
                if Planter.GrowthPercent >= _G.Planter[Id].Percent then
                    ReturnData.NeedToCollect = true
                    ReturnData.Id = Planter.ActorID
                    ReturnData.CFrame = Planter.BulbPart.CFrame
                    break
                end
            end
        end
    end
    return ReturnData
end

