function AutoDig(State)
    if State == nil then
        State = not _G.AutoDiging
    end

    if not State then
        _G.AutoDiging = false
        return
    end

    if _G.AutoDiging then
        return
    end

    _G.AutoDiging = true
    coroutine.wrap(function()
        while _G.AutoDiging do
            TriggerDig()
            task.wait(0.1)
        end
    end)()
end

