                            if Humanoid.Health <= 0 then
                                repeat wait() until Humanoid.Health > 0 or not _G.AutoMobsKill
                                if _G.AutoMobsKill then
                                    TweenTP(Vector3.new(124, 35, 55))
                                end
                            end
                        end
                        TweenTP(Territory.CFrame)
                        if Humanoid.Health <= 0 then
                            repeat wait() until Humanoid.Health > 0 or not _G.AutoMobsKill
                            if _G.AutoMobsKill then
                                TweenTP(Territory.CFrame)
                            end
                        end
                    end
                    SavedPosition = HumRoot.CFrame.Position
                    if NeedToCollectTickets and _G.CollectTickets then
                        for _ = 1, 15 do
